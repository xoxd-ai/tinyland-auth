load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@tummycrypt_tinyland_auth_npm//:defs.bzl", "npm_link_all_packages")
load("@tummycrypt_tinyland_auth_npm//:vitest/package_json.bzl", vitest_bin = "bin")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "tinyland_auth",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/**/*.spec.ts",
        ],
    ) + ["package.json"],
    declaration = True,
    declaration_map = True,
    out_dir = "dist",
    root_dir = "src",
    source_map = False,
    transpiler = "tsc",
    tsconfig = ":tsconfig.json",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/@types/bcryptjs",
        ":node_modules/@types/node",
        ":node_modules/@types/qrcode",
        ":node_modules/bcryptjs",
        ":node_modules/nanoid",
        ":node_modules/otplib",
        ":node_modules/qrcode",
    ],
)

vitest_bin.vitest_test(
    name = "test",
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    data = (
        glob(["src/**/*.ts"]) +
        glob(["tests/**/*.ts"]) +
        glob(["examples/**/*.ts"]) +
        glob(["docs/**/*.md"]) +
        glob([".github/workflows/*.yml", ".github/workflows/*.yaml"])
    ) + [
        ".github/lanes.json",
        "BUILD.bazel",
        "MODULE.bazel",
        "README.md",
        "docs/gf-v4-qualification.candidate.yml",
        "scripts/check-invitation-authority.mjs",
        "scripts/check-package-artifact.mjs",
        "scripts/check-release-metadata.mjs",
        ":node_modules",
        ":node_modules/vitest",
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    log_level = "info",
)

# Execute the existing guards with their real inputs. Merely building //:test
# does not run either guard, and the declaration check needs compiler output.
js_test(
    name = "release_metadata_test",
    entry_point = "scripts/check-release-metadata.mjs",
    data = [
        "scripts/check-release-metadata.mjs",
        "package.json",
        "MODULE.bazel",
        "BUILD.bazel",
        "CHANGELOG.md",
    ],
)

js_test(
    name = "invitation_authority_test",
    entry_point = "scripts/check-invitation-authority.mjs",
    include_types = True,
    data = [
        ":tinyland_auth",
        ":node_modules/typescript",
        "scripts/check-invitation-authority.mjs",
        "src/index.ts",
        "package.json",
    ],
)

# Check the actual Bazel package directory, not a second npm/pnpm pack. Publint
# is a locked third-party validator, never a package-provider publication lane.
js_test(
    name = "package_artifact_test",
    entry_point = "scripts/check-package-artifact.mjs",
    args = ["$(rootpath :pkg)"],
    data = [
        ":pkg",
        ":node_modules/publint",
        "package.json",
        "scripts/check-package-artifact.mjs",
    ],
)

ts_project(
    name = "typecheck",
    srcs = glob(["src/**/*.ts"]) + ["package.json"],
    declaration = False,
    no_emit = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig.json",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/@types/bcryptjs",
        ":node_modules/@types/node",
        ":node_modules/@types/qrcode",
        ":node_modules/bcryptjs",
        ":node_modules/nanoid",
        ":node_modules/otplib",
        ":node_modules/qrcode",
    ],
)

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
        "README.md",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        ":tinyland_auth",
        ":README.md",
        ":package.json",
    ],
    package = "@tummycrypt/tinyland-auth",
    version = "0.7.2",
    publishable = False,
)
