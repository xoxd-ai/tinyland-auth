load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@tummycrypt_tinyland_auth_npm//:defs.bzl", "npm_link_all_packages")
load("@tummycrypt_tinyland_auth_npm//:publint/package_json.bzl", publint_bin = "bin")
load("@tummycrypt_tinyland_auth_npm//:vitest/package_json.bzl", vitest_bin = "bin")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "tinyland_auth",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/**/*.spec.ts",
        ],
    ) + ["package.json"],
    declaration = True,
    declaration_map = True,
    out_dir = "dist",
    root_dir = "src",
    source_map = False,
    transpiler = "tsc",
    tsconfig = ":tsconfig.json",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/@types/bcryptjs",
        ":node_modules/@types/node",
        ":node_modules/@types/qrcode",
        ":node_modules/bcryptjs",
        ":node_modules/nanoid",
        ":node_modules/otplib",
        ":node_modules/qrcode",
    ],
)

vitest_bin.vitest_test(
    name = "test",
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    data = (
        glob(["src/**/*.ts"]) +
        glob(["tests/**/*.ts"]) +
        glob(["examples/**/*.ts"]) +
        glob(["docs/**/*.md"])
    ) + [
        ".github/workflows/ci.yml",
        ".github/workflows/publish.yml",
        "BUILD.bazel",
        "MODULE.bazel",
        "README.md",
        "scripts/check-invitation-authority.mjs",
        "scripts/check-release-metadata.mjs",
        "scripts/ci-bazel-test.sh",
        ":node_modules",
        ":node_modules/vitest",
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    log_level = "info",
)

ts_project(
    name = "typecheck",
    srcs = glob(["src/**/*.ts"]) + ["package.json"],
    declaration = False,
    no_emit = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig.json",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/@types/bcryptjs",
        ":node_modules/@types/node",
        ":node_modules/@types/qrcode",
        ":node_modules/bcryptjs",
        ":node_modules/nanoid",
        ":node_modules/otplib",
        ":node_modules/qrcode",
    ],
)

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
        "README.md",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        ":tinyland_auth",
        ":README.md",
        ":package.json",
    ],
    package = "@tummycrypt/tinyland-auth",
    version = "0.7.1",
)

# TIN-4435/AP3: the three qualification targets the tinyland.dev candidate-image
# publisher's own-workspace gate (qualify-nonprod-canonical-sources.sh) expects
# from this source. Each wraps a check this repo already runs elsewhere
# (release_metadata_test = the `pnpm check:release-metadata` script also run
# by ci.yml's metadata_check_command; invitation_authority_test = the standing
# TIN-2780 tripwire also run as `pnpm check:invitation-authority`;
# package_artifact_test = the `publint` lint ci.yml runs as `pnpm check:package`,
# here pointed at the actual assembled :pkg artifact instead of the source tree).

js_test(
    name = "release_metadata_test",
    data = [
        "BUILD.bazel",
        "CHANGELOG.md",
        "MODULE.bazel",
        "package.json",
        "scripts/check-release-metadata.mjs",
    ],
    chdir = package_name(),
    entry_point = "scripts/check-release-metadata.mjs",
)

js_test(
    name = "invitation_authority_test",
    data = [
        "package.json",
        "scripts/check-invitation-authority.mjs",
        "src/index.ts",
        ":node_modules/typescript",
        ":tinyland_auth_types",
    ],
    chdir = package_name(),
    entry_point = "scripts/check-invitation-authority.mjs",
)

publint_bin.publint_test(
    name = "package_artifact_test",
    args = [
        "$(rootpath :pkg)",
        "--pack",
        "false",
    ],
    data = [":pkg"],
)
